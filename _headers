# Cabeceras de seguridad para el alojamiento (Netlify o Cloudflare Pages). Lo escribe tools/stamp.js: no editar a mano.
# X-Robots-Tag y <meta name="robots">: la beta no debe aparecer en buscadores; quitar ambos al lanzar.
# GitHub Pages no admite cabeceras propias: allí solo actúa la CSP del <meta> del HTML (sin frame-ancestors ni nosniff).
/*
  Content-Security-Policy: default-src 'none'; script-src 'sha256-gfYWHOwNc0+zakDCIxczN1aP8kQGoUA22UpjijXFyKk='; script-src-attr 'none'; style-src 'sha256-dGAnKLQx3YXuuYTMikqhDbSq1kA+aD++546hNEzqYYU='; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Robots-Tag: noindex
/isla_barra_control_mvp.html
  Cache-Control: no-cache
/isla_barra_control_mvp
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
